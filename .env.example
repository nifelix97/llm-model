# Backend API base URL — used by PromptPage and ModelConfigPage.
# Change this if the backend runs on a different host or port.
# Local:    http://localhost:8000
# Render:   set the same key as a build-time env var on your frontend host,
#           e.g. VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=http://localhost:8000

# Public, browser-side Cesium ion token for World Terrain and OSM Buildings.
# Enable both assets and restrict this token by allowed origins in Cesium ion.
# Without it, the Cesium map uses ellipsoid elevation and no 3D buildings.
# This value is exposed to browsers; never put a server secret here.
VITE_CESIUM_ION_ACCESS_TOKEN=
