# Backend API base URL — used by PromptPage and ModelConfigPage.
# Change this if the backend runs on a different host or port.
# Local:    http://localhost:8000
# Render:   set the same key as a build-time env var on your frontend host,
#           e.g. VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=http://localhost:8000
